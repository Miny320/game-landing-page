# Auth (NextAuth v5)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Discord OAuth — Developer Portal → OAuth2 → Redirects:
# http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord OAuth — enable "Server Members Intent" is NOT required for join;
# add guilds.join scope (configured in auth.ts). Bot needs CREATE_INSTANT_INVITE or
# "Add Members" permission in the target guild.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_SUBSCRIBER_ROLE_ID=
NEXT_PUBLIC_DISCORD_INVITE_URL=

# MongoDB (user profiles & payment records)
MONGODB_URI=

# Subscription window length (days) after each successful OVGC payment
SUBSCRIPTION_PERIOD_DAYS=30

# Daily cron — removes Paid User role when subscriptionCurrentPeriodEnd is past
# Vercel Cron calls GET /api/cron/expire-subscriptions with Authorization: Bearer <CRON_SECRET>
# Generate: openssl rand -base64 32
CRON_SECRET=

# OVGC Payments — https://billing.ovgcpayments.com/backend/api/payment-request-api
# Dashboard → API Keys → copy payment API key (ovgc_live_...)
OVGC_API_KEY=ovgc_live_your_key_here
# Dashboard → Webhooks → https://YOUR_DOMAIN/api/ovgc/webhook
# Copy the signing secret shown when you add the endpoint (whsec_...)
OVGC_WEBHOOK_SECRET=
# Optional overrides:
# OVGC_PAYMENT_REQUEST_URL=https://billing.ovgcpayments.com/backend/api/payment-request-api
# OVGC_SUBSCRIPTION_AMOUNT_CENTS=1999
# total_amount is sent in dollars (19.99). Only set if your account expects cents:
# OVGC_TOTAL_AMOUNT_UNIT=cents
# OVGC_PRODUCT_TITLE=Sigma Scripts — Monthly Access

# Disable free manual role grant when OVGC checkout is live
DISCORD_DISABLE_MANUAL_SUBSCRIBE_GRANT=true
