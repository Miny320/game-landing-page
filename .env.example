# Auth (NextAuth v5)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Discord OAuth — Developer Portal → OAuth2 → Redirects:
# http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord OAuth — enable "Server Members Intent" is NOT required for join;
# add guilds.join scope (configured in auth.ts). Bot needs CREATE_INSTANT_INVITE or
# "Add Members" permission in the target guild.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_SUBSCRIBER_ROLE_ID=
NEXT_PUBLIC_DISCORD_INVITE_URL=

# MongoDB (user profiles & payment records)
MONGODB_URI=

# Fallback access window (days) used only if Stripe does not return a period end.
# Normal renewals use the subscription's own current_period_end.
SUBSCRIPTION_PERIOD_DAYS=30

# Daily cron — removes Paid User role when subscriptionCurrentPeriodEnd is past
# Vercel Cron calls GET /api/cron/expire-subscriptions with Authorization: Bearer <CRON_SECRET>
# Generate: openssl rand -base64 32
CRON_SECRET=

# Stripe — recurring monthly subscription via Stripe Checkout
# Dashboard → Developers → API keys (sk_test_... / sk_live_...)
STRIPE_SECRET_KEY=sk_test_your_key_here
# Dashboard → Developers → Webhooks → add endpoint https://YOUR_DOMAIN/api/stripe/webhook
# Subscribe to: checkout.session.completed, checkout.session.async_payment_succeeded,
#               invoice.paid, invoice.payment_failed,
#               customer.subscription.updated, customer.subscription.deleted
# Then copy the endpoint signing secret (whsec_...)
# Local dev: stripe listen --forward-to localhost:3000/api/stripe/webhook
# (use the whsec_... that command prints, not the dashboard one)
STRIPE_WEBHOOK_SECRET=
# Recommended: create a recurring monthly Price in the dashboard and put its id here.
# Leave unset to bill STRIPE_SUBSCRIPTION_AMOUNT_CENTS with an inline monthly price.
# STRIPE_PRICE_ID=price_...
STRIPE_SUBSCRIPTION_AMOUNT_CENTS=1999
STRIPE_CURRENCY=usd
# STRIPE_PRODUCT_TITLE=Sigma Scripts — Monthly Access

# Managed Payments = Stripe acts as merchant of record and handles sales tax/VAT.
# Left off by default: when on, EVERY line item must carry a product tax code or
# checkout fails with "the product tax code is missing".
# To turn it on, set this to true AND set STRIPE_TAX_CODE below (or set a tax code
# on your product in the dashboard if you use STRIPE_PRICE_ID).
# STRIPE_MANAGED_PAYMENTS=true
# Product tax code — browse valid codes at https://docs.stripe.com/tax/tax-categories
# STRIPE_TAX_CODE=txcd_10000000
# Optional Billing Portal configuration id used by /api/billing/portal
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_...

# Disable free manual role grant when Stripe checkout is live
DISCORD_DISABLE_MANUAL_SUBSCRIBE_GRANT=true
